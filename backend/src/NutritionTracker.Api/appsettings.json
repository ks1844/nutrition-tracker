{
  "Urls": "http://localhost:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=nutritiontracker;User ID=nutrition;"
  },
  "Nutrition": {
    "TimeZone": "Asia/Tokyo",
    "MasterImport": {
      "Enabled": true,
      "Path": "Master"
    },
    "Scoring": {
      "BeautyWeights": { "VITC": 1.0, "VITE_ATOC": 1.0, "VITA_RAE": 1.0, "ZN": 0.5 },
      "Muscle": {
        "Weights": { "Protein": 0.6, "Distribution": 0.2, "Energy": 0.2 },
        "ProteinPerMealThresholdG": 20,
        "EnergyTolerance": 0.10,
        "EnergyFalloff": 0.40
      },
      "BaseNutrients": ["FIBTG", "CA", "FE", "MG", "K", "VITB1", "VITB2", "VITB6", "VITB12", "FOL", "VITD"],
      "SaltPenalty": { "Multiplier": 20, "Max": 10 },
      "Bands": { "Good": 80, "Fair": 60 },
      "InsufficientDataDays": 3
    },
    "Targets": {
      "ProteinGPerKg": {
        "skin": 1.0,
        "both": 1.4,
        "muscle": 1.6
      },
      "ActivityFactor": {
        "1": 1.2,
        "2": 1.375,
        "3": 1.55,
        "4": 1.725
      }
    }
  }
}
