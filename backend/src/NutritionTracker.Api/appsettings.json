{
  "Urls": "http://localhost:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=nutritiontracker;User ID=nutrition;"
  },
  "Nutrition": {
    "TimeZone": "Asia/Tokyo",
    "Targets": {
      "ProteinGPerKg": {
        "skin": 1.0,
        "both": 1.4,
        "muscle": 1.6
      },
      "ActivityFactor": {
        "1": 1.2,
        "2": 1.375,
        "3": 1.55,
        "4": 1.725
      }
    }
  }
}
